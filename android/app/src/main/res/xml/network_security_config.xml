<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is denied for every host. Platform HTTP uses HTTPS for geo and connectivity
  probes, while eligible broker requests use the shared Go brokerapi transport. Relay lists are
  verified by brokerapi, but transport must still never downgrade to remote cleartext. Android's
  physical-Network health exception is also HTTPS and targets only the independent gstatic and
  Cloudflare connectivity endpoints; it sends no OpenRung identity or broker headers.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
